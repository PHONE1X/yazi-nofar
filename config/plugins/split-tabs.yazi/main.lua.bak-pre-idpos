--- @since 26.5.6
--- @sync entry

-- nil when inactive; holds all dual-pane state when active.
-- dp.tabs stores yazi TAB IDS (stable across index shifts), not positions --
-- see tab_by_id() below. Positions are resolved fresh at every use because
-- creating/closing tabs elsewhere (e.g. another workspace) renumbers them.
local dp = nil
local saved = {}

-- WORKSPACES: like browser tabs, but each one is a 2-pane split-tabs layout
-- rather than a single directory. WORKSPACES[active_ws] always mirrors the
-- live `dp` (kept in sync by state(), which every external reader goes
-- through) -- everything else is a suspended { tabs = {id1, id2}, pane, preview }
-- snapshot whose underlying yazi tabs still exist in cx.tabs, just not
-- currently composited into view.
local WORKSPACES = {}
local active_ws = nil

local TAG = "split-tabs: "
local function log(msg)
	ya.err(TAG .. tostring(msg))
end

-- Resolve a stable tab id to its CURRENT 1-based position in cx.tabs, or nil
-- if that tab no longer exists (closed elsewhere). Must be called fresh
-- every time -- never cache the result across an emit boundary.
local function tab_by_id(id)
	if not id then return nil end
	for i = 1, #cx.tabs do
		if cx.tabs[i].id == id then return i end
	end
	return nil
end

local function current_tab_id()
	local t = cx.tabs[cx.tabs.idx]
	return t and t.id
end

local function active_pane()
	return current_tab_id() == dp.tabs[2] and 2 or 1
end

local function other_pane()
	return active_pane() == 1 and 2 or 1
end

-- Minimal component: renders static elements. Needs _id/_area for ui.redraw().
local Overlay = {}
function Overlay:new(id, area, elements)
    return setmetatable({ _id = id, _area = area, _elements = elements or {} }, { __index = self })
end

function Overlay:reflow() return {} end

function Overlay:redraw() return self._elements end

-- Polyfill: Marker lacks reflow(), which crashes Tab:reflow() on resize.
if not Marker.reflow then
    Marker.reflow = function() return {} end
end

-- Wraps a Current to suppress cursor highlight via dp._no_cursor flag.
local Pane = {}
function Pane:new(area, tab, active)
    return setmetatable(
        { _id = active and "current" or "my-current", _area = area, _active = active, _inner = Current:new(area, tab) },
        { __index = self }
    )
end

function Pane:reflow() return self._inner:reflow() end

function Pane:redraw()
    dp._no_cursor = not self._active
    local elements = self._inner:redraw()
    dp._no_cursor = nil
    return elements
end

local function apply_dual_tab_patch()
    Tab.layout = function(self)
        -- Bootstrap path: only runs right after activate() queued a
        -- tab_create for a session that had just 1 tab. NOTE: unlike the
        -- old version, this no longer force-closes any tab beyond 2 --
        -- with multiple workspaces, cx.tabs legitimately holds tabs
        -- belonging to OTHER (currently backgrounded) workspaces, and
        -- closing them out from under the user would be silent data loss.
        if dp.creating then
            if #cx.tabs < 2 then
                -- tab_create is async (queued, lands after this function
                -- returns). Tab.layout runs on EVERY redraw -- cursor blink,
                -- unrelated re-renders, etc. -- and without this guard it
                -- kept re-firing tab_create on each of those redraws before
                -- the first one had landed, creating 2-3 extra tabs instead
                -- of 1 (visible as tabs flickering into existence). Emit
                -- exactly once per bootstrap and wait for #cx.tabs to catch up.
                --
                -- This is now the ONLY place that emits the bootstrap
                -- tab_create (activate() used to also emit one directly,
                -- which raced against this one depending on event-processing
                -- order and could itself double-create). Single source of
                -- truth, single guard.
                if not dp.create_pending then
                    dp.create_pending = true
                    log("bootstrap: emitting tab_create (cx.tabs=" .. #cx.tabs .. ")")
                    ya.emit("tab_create", { cx.active.current.cwd })
                end
            else
                dp.create_pending = nil
                if not dp.tabs[2] then
                    -- The queued tab_create above has now landed. Capture
                    -- whichever tab isn't pane 1 as pane 2's id.
                    local i1 = tab_by_id(dp.tabs[1])
                    for i = 1, #cx.tabs do
                        if i ~= i1 then
                            dp.tabs[2] = cx.tabs[i].id
                            if active_ws then WORKSPACES[active_ws].tabs = dp.tabs end
                            break
                        end
                    end
                    log("bootstrap: captured tabs=" .. tostring(dp.tabs[1]) .. "," .. tostring(dp.tabs[2])
                        .. " cx.tabs=" .. #cx.tabs)
                    -- tab_create made the new tab active; switch back so the
                    -- original tab (pane 1) stays the active/left pane.
                    if i1 then
                        ya.emit("tab_switch", { i1 - 1 })
                    end
                end
                dp.creating = nil
            end
        end

        dp.pane = active_pane()

        -- Preview on: split vertically first, then horizontally for panes.
        local pane_area = self._area
        if dp.preview then
            local vsplit = ui.Layout()
                :direction(ui.Layout.VERTICAL)
                :constraints({
                    ui.Constraint.Fill(1),
                    ui.Constraint.Fill(1),
                })
                :split(self._area)
            pane_area = vsplit[1]
            dp.preview_area = vsplit[2]
        else
            dp.preview_area = nil
        end

        -- Active pane uses the "current" slot; inactive gets a zero-width slot.
        self._chunks = ui.Layout()
            :direction(ui.Layout.HORIZONTAL)
            :constraints({
                ui.Constraint.Fill(1),
                ui.Constraint.Fill(1),
                ui.Constraint.Length(0),
            })
            :split(pane_area)
    end

    Tab.build = function(self, ...)
        saved.tab_build(self, ...)

        local c = self._chunks
        local i1, i2 = tab_by_id(dp.tabs[1]), tab_by_id(dp.tabs[2])
        local tab1 = i1 and cx.tabs[i1]
        local tab2 = i2 and cx.tabs[i2]

        if not tab1 or not tab2 then
            self._children = {}
            return
        end

        self._children = {
            Pane:new(c[1]:pad(ui.Pad(0, 0, 0, 1)), tab1, dp.pane == 1),
            Pane:new(c[2]:pad(ui.Pad.x(1)), tab2, dp.pane == 2),

            Marker:new(c[1], tab1.current),

            Rails:new(c, self._tab), -- draw a rail between "parent" and "current" panels
            Marker:new(c[2], tab2.current),
        }

        if dp.preview and dp.preview_area then
            -- Overlap preview 1 row up to share the pane's bottom border line.
            local pa = dp.preview_area
            local joined = ui.Rect { x = pa.x, y = pa.y - 1, w = pa.w, h = pa.h + 1 }
            self._children[#self._children + 1] = Overlay:new("border", joined, {
                ui.Border(ui.Edge.ALL):area(joined),
            })
            self._children[#self._children + 1] = Preview:new(joined:pad(ui.Pad(1, 1, 1, 1)), self._tab)
        else
            -- Zero-width "preview" rect prevents stale Rust-side preview rendering.
            -- Height stays non-zero so Folder::make window size isn't clamped to 0.
            self._children[#self._children + 1] = Overlay:new("preview",
                ui.Rect { x = 0, y = 0, w = 0, h = self._area.h }, {})
        end
    end
end

local function apply_header_patch()
    Header.cwd = function(self)
        local w = self._area.w

        -- Workspace indicator, e.g. "[2/5] ", only shown once there's more
        -- than one workspace -- keeps the header exactly as before for the
        -- common single-workspace case.
        local ws_prefix = ""
        if active_ws and #WORKSPACES > 1 then
            ws_prefix = "[" .. active_ws .. "/" .. #WORKSPACES .. "] "
        end
        local avail = math.max(0, w - #ws_prefix)
        local mid = math.floor(avail / 2) - 1

        local i1, i2 = tab_by_id(dp.tabs[1]), tab_by_id(dp.tabs[2])
        local tab1 = i1 and cx.tabs[i1]
        local tab2 = i2 and cx.tabs[i2]
        local pane = dp.pane or 1

        if not tab1 then return "" end

        if not tab2 then
            local s = ya.readable_path(tostring(tab1.current.cwd))
            return ui.Line {
                ui.Span(ws_prefix),
                ui.Span(ui.truncate(s, { max = avail, rtl = true })):style(th.tabs.active),
            }
        end

        -- Left path: pad to exactly `mid` columns so the separator aligns with the pane split.
        local p1 = ya.readable_path(tostring(tab1.current.cwd))
        p1 = ui.truncate(p1, { max = mid, rtl = true })
        local pad = mid - #p1
        if pad > 0 then
            p1 = p1 .. string.rep(" ", pad)
        end

        local right_avail = math.max(0, avail - mid - 1 - (self._right_width or 0)) - 4
        local p2 = ya.readable_path(tostring(tab2.current.cwd))
        p2 = ui.truncate(p2, { max = right_avail, rtl = true })

        local s_active = th.tabs.active
        local s_inactive = th.tabs.inactive

        return ui.Line {
            ui.Span(ws_prefix),
            ui.Span(p1):style(pane == 1 and s_active or s_inactive),
            ui.Span(" "),
            ui.Span(p2):style(pane == 2 and s_active or s_inactive),
        }
    end
end

local function restore_all()
    Tab.layout = saved.tab_layout
    Tab.build = saved.tab_build
    Header.cwd = saved.header_cwd
    Tabs.height = saved.tabs_height
    Entity.style = saved.entity_style
end

local function activate()
    if dp then return end

    ps.sub("ind-watch", function(args)
        local i1, i2 = tab_by_id(dp.tabs[1]), tab_by_id(dp.tabs[2])
        args.files = {
            i1 and cx.tabs[i1].current.file,
            i2 and cx.tabs[i2].current.file,
        }

        -- If the preview pane is active and the hovered entity is a directory,
        -- add it to the watch list as well so that the directory can be loaded when absent.
        -- (active_pane() returns a pane SLOT (1/2), not a tab index -- resolve
        -- via the id it maps to, same as everywhere else in this file. This
        -- was cx.tabs[active_pane()] before, which only worked by coincidence
        -- when that pane's real tab happened to sit at position 1 or 2.)
        local active_idx = tab_by_id(dp.tabs[active_pane()])
        local hovered = active_idx and cx.tabs[active_idx].current.hovered
        if dp.preview and hovered and hovered.cha.is_dir then
            args.files[#args.files + 1] = hovered
        end

        return args
    end)

    ps.sub("relay-update-files", function(args)
        local i1, i2 = tab_by_id(dp.tabs[1]), tab_by_id(dp.tabs[2])
        args.tabs = { i1 and cx.tabs[i1].id, i2 and cx.tabs[i2].id }
        return args
    end)

    saved.tab_layout = Tab.layout
    saved.tab_build = Tab.build
    saved.header_cwd = Header.cwd
    saved.tabs_height = Tabs.height
    saved.entity_style = Entity.style

    Entity.style = function(self)
        if dp and dp._no_cursor then
            return self._file:style() or ui.Style()
        end
        return saved.entity_style(self)
    end

    Tabs.height = function() return 0 end

    local n = #cx.tabs
    local cur = cx.tabs.idx
    local id1 = current_tab_id()
    local id2

    if n >= 2 then
        local tab2_idx = (cur < n) and (cur + 1) or 1
        id2 = cx.tabs[tab2_idx] and cx.tabs[tab2_idx].id
    end
    -- else: id2 stays nil, n < 2. Previously this branch ALSO emitted its
    -- own tab_create + tab_switch here, racing against the one Tab.layout's
    -- dp.creating branch emits below (order between the two queued async
    -- events vs. the render this function triggers is not guaranteed) --
    -- could land as either a harmless no-op guard-catch or an actual double
    -- tab_create depending on which processed first. Tab.layout's guarded
    -- bootstrap path is now the single source of truth for this; nothing
    -- to do here.

    dp = { pane = 1, view = "dual", tabs = { id1, id2 }, creating = (n < 2) or nil, preview = false }
    log("activate: n=" .. n .. " id1=" .. tostring(id1) .. " id2=" .. tostring(id2)
        .. " creating=" .. tostring(dp.creating))
    WORKSPACES = { { tabs = dp.tabs, pane = 1, preview = false } }
    active_ws = 1

    apply_dual_tab_patch()
    apply_header_patch()
    ui.render()
end

local function deactivate()
    if not dp then return end
    log("deactivate: tabs=" .. tostring(dp.tabs[1]) .. "," .. tostring(dp.tabs[2])
        .. " creating=" .. tostring(dp.creating))
    ps.unsub("ind-watch")
    ps.unsub("relay-update-files")
    -- Only the current workspace's second pane is closed on deactivate;
    -- other (backgrounded) workspaces' tabs are left alone as ordinary
    -- flat yazi tabs -- deactivating the composited view doesn't mean
    -- discarding work sitting in other workspaces.
    local idx = tab_by_id(dp.tabs[other_pane()])
    if idx then
        ya.emit("tab_close", { idx - 1 })
    end
    restore_all()
    dp = nil
    WORKSPACES = {}
    active_ws = nil
    saved = {}
    ui.render()
end

local function spl_activate()
    activate()
end

local function spl_deactivate()
    deactivate()
end

local function spl_toggle()
    log("spl_toggle: dp is " .. (dp and "active, deactivating" or "inactive, activating"))
    if dp then deactivate() else activate() end
end

local function spl_preview()
    if not dp then return end
    dp.preview = not dp.preview
    ui.render()
    if dp.preview then
        ya.emit("peek", { 0 })
    else
        -- Different skip value forces preview.reset() which clears protocol images.
        ya.emit("peek", { 99999 })
    end
end

local function spl_switch_tab()
    if not dp then return end
    local idx = tab_by_id(dp.tabs[other_pane()])
    if idx then
        ya.emit("tab_switch", { idx - 1 })
    end
    ui.render()
end

-- Apply a file operation to the selection (or the hovered file) and send it
-- to the other pane, via yazi's own yank/paste task queue -- the same
-- mechanism the "y"/"p" bindings use. This runs recursively on directories,
-- shows progress, and prompts on name conflicts, none of which a hand-rolled
-- copy would get for free.
--
-- NOTE: this used to call `ya.task(op, {from=, to=})`, which is not a real
-- yazi API (not in the docs, not in yazi's source). It always failed
-- silently inside the unprotected ya.async block above -- so copy/move via
-- split-tabs has never actually worked, in either keymap. Fixed here by
-- driving yank + paste across a tab_switch instead.
local function spl_transfer(operation)
    if not dp then
        log("spl_transfer: dual-pane is off, ignoring")
        return
    end

    local src_pane = active_pane()
    local dst_pane = other_pane()
    local src_idx = tab_by_id(dp.tabs[src_pane])
    local dst_idx = tab_by_id(dp.tabs[dst_pane])
    if not src_idx or not dst_idx then
        log("spl_transfer: could not resolve src/dst tab id, aborting")
        return
    end
    local source = cx.tabs[src_idx]

    local n = 0
    for _ in pairs(source.selected) do
        n = n + 1
    end
    if n == 0 and not source.current.hovered then
        log("spl_transfer: nothing selected or hovered, nothing to do")
        return
    end

    log("spl_transfer: op=" .. operation .. " src_pane=" .. src_pane .. " dst_pane=" .. dst_pane
        .. " selected=" .. n .. " hovered=" .. tostring(source.current.hovered and source.current.hovered.url))

    ya.emit("yank", operation == "move" and { cut = true } or {})
    ya.emit("tab_switch", { dst_idx - 1 })
    ya.emit("paste", {})
    ya.emit("tab_switch", { src_idx - 1 })
    -- paste queues a background task and returns immediately; by the time
    -- tab_switch above lands us back on src_pane, dst_pane is no longer the
    -- active tab, and this plugin's composited dual-pane view (unlike core
    -- yazi's own single-pane redraw) does not repaint on background task
    -- completion for a non-active tab -- see spl_switch_tab's ui.render()
    -- for the same reason. Force a repaint so dst_pane shows the transfer
    -- without the user having to switch into it first.
    ui.render()
end

local function spl_copy()
    spl_transfer("copy")
end

local function spl_move()
    spl_transfer("move")
end

-- ======================= workspaces (browser-tab-like) =======================
-- A "workspace" is a full 2-pane split-tabs layout, same shape as `dp` minus
-- the transient _no_cursor/preview_area/creating fields. Switching workspace
-- swaps which 2 underlying yazi tabs are composited into the 2 visible panes
-- in one shot; the tabs belonging to a backgrounded workspace are untouched
-- and still exist in cx.tabs, just not currently rendered.
--
-- LIMITATION (known, deliberate for this pass): only the ACTIVE workspace
-- survives a vim<->far mode-switch restart -- far-mode's capture/restore
-- reads state().tabs/pane/preview (the active workspace, same shape as
-- before workspaces existed) and knows nothing about WORKSPACES. Background
-- workspaces are silently dropped on a mode switch. Extending the restore
-- chain to all workspaces is a separate, carefully-tested follow-up.

-- One in-flight "creating a new workspace" operation at a time. Holds the
-- ids collected so far and how many more panes are needed. See
-- spl_new_workspace / new_ws_poll.
local pending_ws = nil

local function ids_snapshot()
    local s = {}
    for i = 1, #cx.tabs do
        s[cx.tabs[i].id] = true
    end
    return s
end

local function id_not_in(before)
    for i = 1, #cx.tabs do
        if not before[cx.tabs[i].id] then
            return cx.tabs[i].id
        end
    end
    return nil
end

local function switch_workspace(delta)
    if not dp then
        -- No dual-pane active: fall back to yazi's native relative tab
        -- switch, exactly what these keys did before workspaces existed.
        ya.emit("tab_switch", { delta, relative = true })
        return
    end
    if #WORKSPACES < 2 then
        return -- nothing to switch to
    end

    WORKSPACES[active_ws] = { tabs = dp.tabs, pane = dp.pane, preview = dp.preview }
    active_ws = ((active_ws - 1 + delta) % #WORKSPACES) + 1
    local ws = WORKSPACES[active_ws]
    dp = { pane = ws.pane, tabs = ws.tabs, preview = ws.preview }

    local idx = tab_by_id(dp.tabs[dp.pane])
    if idx then
        ya.emit("tab_switch", { idx - 1 })
    else
        log("switch_workspace: active pane's tab id did not resolve, view may be stale")
    end
    ui.render()
    log("switch_workspace: now on " .. active_ws .. "/" .. #WORKSPACES)
end

local function spl_next_workspace()
    switch_workspace(1)
end

local function spl_prev_workspace()
    switch_workspace(-1)
end

local function spl_new_workspace()
    if not dp then
        -- No dual-pane active: fall back to yazi's native new-tab, exactly
        -- what this key did before workspaces existed.
        ya.emit("tab_create", { cx.active.current.cwd })
        return
    end
    if pending_ws then
        log("spl_new_workspace: already creating one, ignoring")
        return
    end

    -- Flush the live layout back into WORKSPACES before branching off, same
    -- as switch_workspace does.
    WORKSPACES[active_ws] = { tabs = dp.tabs, pane = dp.pane, preview = dp.preview }

    local base_cwd = cx.active.current.cwd
    pending_ws = {
        ids_before = ids_snapshot(),
        remaining = 2, -- pane count is fixed at 2 for now; see module comment
        collected = {},
        preview = dp.preview,
        base_cwd = base_cwd,
    }
    ya.emit("tab_create", { base_cwd })
    ya.emit("plugin", { "split-tabs", "new_ws_poll:0" })
end

local function new_ws_poll(n)
    if not pending_ws then
        return
    end

    local new_id = id_not_in(pending_ws.ids_before)
    if not new_id then
        if n < 40 then
            ya.emit("plugin", { "split-tabs", "new_ws_poll:" .. (n + 1) })
        else
            log("new_ws_poll: tab_create never landed after " .. n .. " waits, giving up")
            pending_ws = nil
        end
        return
    end

    pending_ws.collected[#pending_ws.collected + 1] = new_id
    pending_ws.ids_before = ids_snapshot()
    pending_ws.remaining = pending_ws.remaining - 1

    if pending_ws.remaining > 0 then
        ya.emit("tab_create", { pending_ws.base_cwd })
        ya.emit("plugin", { "split-tabs", "new_ws_poll:0" })
        return
    end

    -- Done: finalize the new workspace and switch to it.
    WORKSPACES[#WORKSPACES + 1] = { tabs = pending_ws.collected, pane = 1, preview = pending_ws.preview }
    active_ws = #WORKSPACES
    dp = { pane = 1, tabs = pending_ws.collected, preview = pending_ws.preview }

    local idx = tab_by_id(dp.tabs[1])
    if idx then
        ya.emit("tab_switch", { idx - 1 })
    end
    log("new_ws_poll: workspace " .. active_ws .. " created (" .. #WORKSPACES .. " total)")
    pending_ws = nil
    ui.render()
end

local function spl_close_workspace()
    if not dp then
        return
    end
    if #WORKSPACES < 2 then
        -- Nothing to fall back to -- closing the only workspace means
        -- turning dual-pane off entirely.
        deactivate()
        return
    end

    local closing = WORKSPACES[active_ws]
    table.remove(WORKSPACES, active_ws)
    if active_ws > #WORKSPACES then
        active_ws = #WORKSPACES
    end

    local idxs = {}
    for _, id in ipairs(closing.tabs) do
        local i = tab_by_id(id)
        if i then
            idxs[#idxs + 1] = i
        end
    end
    table.sort(idxs, function(a, b) return a > b end)
    for _, i in ipairs(idxs) do
        ya.emit("tab_close", { i - 1 })
    end

    local ws = WORKSPACES[active_ws]
    dp = { pane = ws.pane, tabs = ws.tabs, preview = ws.preview }

    -- The tab_close emits above are queued, not yet applied -- cx.tabs
    -- still reflects pre-close positions here. Compute where the target
    -- tab WILL be once they land, by subtracting however many closed
    -- indices sit below it, rather than waiting another round trip.
    local target_idx = tab_by_id(dp.tabs[dp.pane])
    if target_idx then
        local shift = 0
        for _, i in ipairs(idxs) do
            if i < target_idx then
                shift = shift + 1
            end
        end
        ya.emit("tab_switch", { target_idx - shift - 1 })
    end
    log("spl_close_workspace: now on " .. active_ws .. "/" .. #WORKSPACES)
    ui.render()
end

local function entry(st, job)
    job = type(job) == "string" and { args = { job } } or job
    local act = job and job.args and job.args[1]

    if act == "spl_activate" then
        spl_activate()
    elseif act == "spl_deactivate" then
        spl_deactivate()
    elseif act == "spl_toggle" then
        spl_toggle()
    elseif act == "spl_switch_tab" then
        spl_switch_tab()
    elseif act == "spl_copy" then
        spl_copy()
    elseif act == "spl_move" then
        spl_move()
    elseif act == "spl_preview" then
        spl_preview()
    elseif act == "spl_new_workspace" then
        spl_new_workspace()
    elseif act == "spl_next_workspace" then
        spl_next_workspace()
    elseif act == "spl_prev_workspace" then
        spl_prev_workspace()
    elseif act == "spl_close_workspace" then
        spl_close_workspace()
    elseif type(act) == "string" and act:find("^new_ws_poll:") then
        local n = act:match("^new_ws_poll:(%d+)$")
        new_ws_poll(tonumber(n) or 0)
    end
end

local function state()
    if not dp then return nil end
    -- Keep WORKSPACES[active_ws] fresh for any external reader (far-mode's
    -- capture_state, most importantly) -- it only gets written on an actual
    -- switch/new/close otherwise, and callers expect the LIVE layout.
    if active_ws then
        WORKSPACES[active_ws] = { tabs = dp.tabs, pane = dp.pane, preview = dp.preview }
    end
    return {
        tabs = dp.tabs, pane = dp.pane, preview = dp.preview,
        ws_index = active_ws, ws_count = #WORKSPACES, workspaces = WORKSPACES,
    }
end

-- Published as a plain global so far-mode can read dual-pane state from its
-- own @sync entry. A cross-plugin require() is not usable there: it yields,
-- and a @sync entry is not a coroutine. Both plugins' entries run in the same
-- sync Lua state, so a shared global reaches the live `dp` upvalue. If yazi
-- ever sandboxes plugin globals this simply reads back nil, which far-mode
-- treats as "dual-pane inactive" -- a safe failure, not a broken one.
SPLIT_TABS = SPLIT_TABS or {}
SPLIT_TABS.state = state

return { entry = entry, state = state }
