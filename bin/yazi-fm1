#!/usr/bin/env python3
"""org.freedesktop.FileManager1 -> Yazi.

Приложения зовут этот D-Bus интерфейс, когда нужно «Показать в папке»
(Telegram, Firefox, Chromium, Steam...). Без него отвечал Dolphin. Сервис
открывает Yazi через yazi-open: папку — как есть, файл — с курсором на нём.

Запускается D-Bus-активацией по файлу
~/.local/share/dbus-1/services/org.freedesktop.FileManager1.service
и сам выходит после 5 минут простоя.

YAZI_FM1_DRYRUN=<файл> — для проверки: вместо окна дописать в файл, что
было бы открыто.
"""

import os
import subprocess

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

NAME = "org.freedesktop.FileManager1"
PATH = "/org/freedesktop/FileManager1"
IDLE_SECONDS = 300

XML = """
<node>
  <interface name="org.freedesktop.FileManager1">
    <method name="ShowFolders">
      <arg type="as" name="URIs" direction="in"/>
      <arg type="s" name="StartupId" direction="in"/>
    </method>
    <method name="ShowItems">
      <arg type="as" name="URIs" direction="in"/>
      <arg type="s" name="StartupId" direction="in"/>
    </method>
    <method name="ShowItemProperties">
      <arg type="as" name="URIs" direction="in"/>
      <arg type="s" name="StartupId" direction="in"/>
    </method>
  </interface>
</node>
"""

OPEN = os.path.join(os.path.dirname(os.path.realpath(__file__)), "yazi-open")
DRYRUN = os.environ.get("YAZI_FM1_DRYRUN")

loop = GLib.MainLoop()
idle_timer = 0


def rearm_idle():
    global idle_timer
    if idle_timer:
        GLib.source_remove(idle_timer)
    idle_timer = GLib.timeout_add_seconds(IDLE_SECONDS, quit_loop)


def quit_loop(*_):
    loop.quit()
    return False


def launch(method, uris, startup_id):
    if not uris:
        return
    if DRYRUN:
        with open(DRYRUN, "a") as f:
            f.write(f"{method} {uris[0]}\n")
        return
    env = dict(os.environ)
    if startup_id:
        # токен xdg-activation: окно kitty получит фокус на Wayland
        env["XDG_ACTIVATION_TOKEN"] = startup_id
    subprocess.Popen(
        [OPEN, uris[0]],
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def on_call(conn, sender, path, iface, method, params, invocation):
    uris, startup_id = params.unpack()
    try:
        launch(method, list(uris), startup_id)
    finally:
        invocation.return_value(None)
        rearm_idle()


def on_bus_acquired(conn, name):
    node = Gio.DBusNodeInfo.new_for_xml(XML)
    conn.register_object(PATH, node.interfaces[0], on_call, None, None)


def on_name_lost(conn, name):
    # имя уже занято другим файловым менеджером — молча выходим
    loop.quit()


Gio.bus_own_name(
    Gio.BusType.SESSION,
    NAME,
    Gio.BusNameOwnerFlags.NONE,
    on_bus_acquired,
    None,
    on_name_lost,
)
rearm_idle()
loop.run()
